# Copy to .env before the first `docker compose up`:   cp .env.example .env
# Then replace every change-me value. Never commit .env.
# Use only letters, digits, "-" and "_" in passwords: they are embedded in connection URLs.

# Hardware profile: ci | laptop | desktop  (config/profiles/<name>.yaml)
APP_PROFILE=laptop

# Origin of the web frontend; storage CORS allows browser uploads from it.
WEB_ORIGIN=http://localhost:3000

# Postgres
POSTGRES_USER=copilot
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=copilot

# Redis (job queue)
REDIS_PASSWORD=change-me-redis-password

# Object storage (RustFS, S3-compatible; see ADR-0006)
# Root (admin) account: used only by the storage server and storage-init.
STORAGE_ROOT_USER=change-me-storage-user
STORAGE_ROOT_PASSWORD=change-me-storage-password
STORAGE_BUCKET=meeting-copilot
# The API's and worker's own account, limited to the bucket. Created by storage-init;
# change the secret and run `docker compose up -d` again to rotate it.
STORAGE_APP_ACCESS_KEY=change-me-storage-app-user
STORAGE_APP_SECRET_KEY=change-me-storage-app-secret
